# === GPN Assistant: доступные переменные окружения (docker compose читает .env) ===
#
# Скопируйте в .env и подставьте свои значения. Для локального запуска ничего
# менять не обязательно — все дефолты рабочие.

# --- Модель / Ollama ---
LLM_MODEL=gemma4:e2b-it-qat
LLM_NUM_CTX=8192
OLLAMA_HOST=http://localhost:11434
# Самопроверка ответа LLM («подтверждён ли ответ контекстом базы знаний?») — 0/1.
# Включена по умолчанию: при несоответствии ответ заменяется регламентированным отказом.
LLM_SELF_CHECK=1
MAX_HISTORY_TURNS=6
OLLAMA_MAX_RETRIES=3
AGENT_MAX_ITERATIONS=3

# --- Пути (внутри контейнера по умолчанию = named-тома, не менять) ---
CHROMADB_DIR=chromadb
DATA_DIR=data
# Формат словаря определяется расширением: .json — {аббревиатура: расшифровка},
# .csv — таблица term,definition (UTF-8 с BOM, удобно править в Excel).
DICTIONARY_FILE=corporate_dictionary.json
HISTORY_FILE=history.json

# --- Сервис ---
# Прогрев ML-моделей в фоне при старте (0 — выключить, удобно для тестов)
WARMUP_MODELS=1
# Максимальный размер загружаемого файла, МБ
UPLOAD_MAX_MB=50
# Разрешённые CORS-источники через запятую (для продакшена заменить * на конкретные)
CORS_ORIGINS=*
# Параллельность тяжёлых вызовов моделей на CPU
SEARCH_CONCURRENCY=2

# --- Redis (опционально; без него сессии живут в памяти с TTL) ---
# REDIS_URL=redis://redis:6379/0

# --- Langfuse tracing (опционально) ---
LANGFUSE_HOST=http://langfuse:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# LANGFUSE_ENABLED=1

# --- docker compose (образы) ---
OLLAMA_IMAGE=gpn-ollama:latest
NEXTAUTH_SECRET=change-me
LANGFUSE_SALT=change-me