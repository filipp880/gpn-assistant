# GPN Assistant — переменные окружения
# Скопируйте в .env и заполните значения

# --- LLM ---
LLM_MODEL=gemma4:e2b-it-qat
LLM_NUM_CTX=8192
MAX_HISTORY_TURNS=6
OLLAMA_MAX_RETRIES=3

# --- Redis (персистентность сессий) ---
REDIS_URL=redis://localhost:6379/0

# --- Langfuse Tracing (опционально) ---
# 1. Запустите: docker compose up langfuse langfuse-db -d
# 2. Откройте http://localhost:3000, создайте проект
# 3. Скопируйте ключи из Project Settings -> API Keys
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_ENABLED=0  # явно отключить трейсинг (по умолчанию auto-detect)
